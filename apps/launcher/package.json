{
	"name": "@cavs/launcher",
	"version": "0.0.0",
	"private": true,
	"main": "dist/main.js",
	"scripts": {
		"build": "tsc --noEmit && vite build",
		"dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p ./electron/tsconfig.json && electron .\"",
		"lint": "biome check --write .",
		"preview": "vite preview"
	},
	"dependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@cavs/ts-config": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"concurrently": "^9.2.0",
		"electron": "23.3.13",
		"file-icon": "^5.1.1",
		"globals": "^16.3.0",
		"regedit": "^5.1.4",
		"ts-node": "^10.9.2",
		"typescript": "~5.8.3",
		"vite": "^7.0.4",
		"wait-on": "^8.0.4",
		"windows-shortcuts": "^0.1.6"
	}
}
