{
	"name": "cavs",
	"private": true,
	"description": "Monorepo for CAVS projects",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"changeset": "changeset",
		"check-types": "turbo run check-types",
		"dev": "turbo run dev",
		"format:packages": "npx sort-package-json \"**/package.json\" --ignore \"**/node_modules/**/package.json\"",
		"init-repo": "turbo build -F '!./apps/*'  && pnpm install --frozen-lockfile",
		"lint": "turbo run lint",
		"publish": "changeset publish",
		"remove_modules": "bash remove_modules.sh",
		"test": "turbo run test",
		"version": "changeset version && turbo run build"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.3",
		"@changesets/cli": "^2.29.5",
		"@types/node": "catalog:",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"globals": "^16.3.0",
		"turbo": "^2.5.4",
		"typescript": "catalog:",
		"vite": "^7.0.4",
		"vite-plugin-dts": "^4.5.4"
	},
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=18"
	}
}
