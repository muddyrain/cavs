{
	"name": "cavs",
	"private": true,
	"description": "Monorepo for CAVS projects",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev": "turbo run dev",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"lint": "turbo run lint",
		"rm_modules": "bash remove_modules.sh"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "catalog:",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.3",
		"prettier": "catalog:",
		"prettier-plugin-packagejson": "^2.5.19",
		"turbo": "^2.5.4",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=18"
	}
}
