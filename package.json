{
	"name": "cavs",
	"private": true,
	"description": "Monorepo for CAVS projects",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"changeset": "changeset",
		"check-types": "turbo run check-types",
		"dev": "turbo run dev",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"lint": "turbo run lint",
		"publish": "changeset publish",
		"rm_modules": "bash remove_modules.sh",
		"test": "turbo run test",
		"version": "changeset version && turbo run build"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.3",
		"@changesets/cli": "^2.29.5",
		"@types/node": "catalog:",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "catalog:",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.3",
		"prettier": "catalog:",
		"prettier-plugin-packagejson": "^2.5.19",
		"turbo": "^2.5.4",
		"typescript": "catalog:",
		"@eslint/js": "^9.30.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.3.0",
		"typescript-eslint": "^8.36.0",
		"vite": "^7.0.4",
		"vite-plugin-dts": "^4.5.4"
	},
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=18"
	}
}
