{
	"extends": "@cavs/ts-config",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": false,
		"allowImportingTsExtensions": false,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"sourceMap": true,
		"target": "es2015",
		"outDir": "${configDir}/dist"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
