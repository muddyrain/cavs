{
	"extends": "@cavs/ts-config",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": false,
		"allowImportingTsExtensions": false,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"outDir": "${configDir}/dist",
		"declaration": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
